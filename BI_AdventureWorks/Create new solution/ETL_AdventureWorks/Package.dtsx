                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Commande SQL à exécuter."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT p.ProductID, p.ProductNumber, p.Name AS ProductName,
         ISNULL(pc.Name,'N/A') AS Category,
         ISNULL(ps.Name,'N/A') AS SubCategory,
         ISNULL(p.Color,'N/A') AS Color,
         p.StandardCost, p.ListPrice
  FROM Production.Product p
  LEFT JOIN Production.ProductSubcategory ps ON p.ProductSubcategoryID=ps.ProductSubcategoryID
  LEFT JOIN Production.ProductCategory pc ON ps.ProductCategoryID=pc.ProductCategoryID</property>
                <property
                  dataType="System.String"
                  description="Variable contenant la commande SQL à exécuter."
